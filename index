      <!-- ==================================================================
           SLIDE 02: 오버뷰 (OVERVIEW - 02_오버뷰.md)
           피그마 02. overview 레이아웃 충실 반영 (중앙 정렬 구조)
           ================================================================== -->
      <div class="slide" id="slide-2" style="justify-content: center; align-items: center; text-align: center;">
        <div style="max-width: 1400px; width: 100%; display: flex; flex-direction: column; align-items: center; margin: 0 auto;">
          <div style="margin-bottom: 32px;">
            <span class="badge badge-black slide-kicker" style="font-size: 15px; padding: 8px 24px; letter-spacing: 1.2px; display: inline-block; margin-bottom: 0;">02. OVERVIEW · 프로젝트 출발점</span>
          </div>
          
          <h2 class="slide-title" style="font-size: 52px; font-weight: 900; line-height: 1.35; letter-spacing: -1.5px; margin-bottom: 44px; word-break: keep-all; max-width: 1320px;">
            결제의 편리함은 그대로,<br />혜택 경험은 더 명확하게 만들 수 있을까?
          </h2>

