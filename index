<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>네이버페이 앱 현장결제 리디자인 발표 슬라이드</title>
  <!-- Pretendard Webfont CDN -->
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      color: #000000;
      border-radius: 0 !important; /* Zero corner radius */
    }

    body {
      background-color: #f4f5f7;
      overflow: hidden;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
    }

    /* 1920 x 1080 Base Presentation Viewport */
    #viewport {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    #presentation-stage {
      width: 1920px;
      height: 1080px;
      position: absolute;
      transform-origin: center center;
      background-color: #ffffff;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
      border-radius: 0;
      overflow: hidden;
    }

    /* Slide Frame Base (Generous padding without head & foot) */
    .slide {
      position: absolute;
      top: 0;
      left: 0;
      width: 1920px;
      height: 1080px;
      padding: 68px 96px;
      background-color: #ffffff;
      display: none !important;
      flex-direction: column;
      justify-content: space-between;
      opacity: 0;
      transition: opacity 0.2s ease-in-out;
    }

    .slide.active {
      display: flex !important;
      opacity: 1;
    }

    /* Typography Hierarchy */
    .headline-block {
      margin-bottom: 22px;
    }

    .slide-kicker {
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 1.2px;
      margin-bottom: 10px;
      text-transform: uppercase;
      display: block;
    }

    .slide-title {
      font-size: 40px;
      font-weight: 900;
      line-height: 1.28;
      letter-spacing: -1px;
      margin-bottom: 10px;
    }

    .slide-desc {
      font-size: 18.5px;
      font-weight: 500;
      line-height: 1.55;
      letter-spacing: -0.4px;
      max-width: 1680px;
    }

    /* Content Area */
    .slide-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 16px;
      width: 100%;
    }

    /* Card System */
    .white-card {
      background-color: #ffffff;
      border: 1px solid #000000; /* Black outline ONLY on white shapes */
      border-radius: 0;
      padding: 24px 28px;
    }

    .gray-card {
      background-color: #f4f5f7;
      border: none !important; /* No black outline on gray shapes */
      border-radius: 0;
      padding: 24px 28px;
    }

    .dark-card {
      background-color: #333333;
      border: none !important; /* No black outline on dark gray shapes */
      border-radius: 0;
      padding: 24px 28px;
      color: #ffffff !important; /* White text on dark gray shapes */
    }
    .dark-card * {
      color: #ffffff !important;
    }

    .black-card {
      background-color: #000000;
      border: none !important; /* No black outline on black shapes */
      border-radius: 0;
      padding: 24px 28px;
      color: #ffffff !important; /* White text on black shapes */
    }
    .black-card * {
      color: #ffffff !important;
    }

    /* Key Insight Banner */
    .key-insight-banner {
      width: 100%;
      background-color: #f4f5f7;
      border: none !important; /* No outline on light gray banner */
      border-radius: 0;
      padding: 18px 30px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .key-insight-banner.banner-black {
      background-color: #000000;
      color: #ffffff !important;
      border: none !important;
    }
    .key-insight-banner.banner-black * {
      color: #ffffff !important;
    }

    .key-insight-banner.banner-dark {
      background-color: #333333;
      color: #ffffff !important;
      border: none !important;
    }
    .key-insight-banner.banner-dark * {
      color: #ffffff !important;
    }

    .key-insight-kicker {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .key-insight-text {
      font-size: 19px;
      font-weight: 800;
      line-height: 1.45;
      letter-spacing: -0.4px;
    }

    /* Badges & Chips */
    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 12px;
      border-radius: 0;
      font-size: 12.5px;
      font-weight: 800;
      line-height: 1;
    }

    .badge-white {
      background-color: #ffffff;
      border: 1px solid #000000; /* White shape: black outline */
      color: #000000;
    }

    .badge-gray {
      background-color: #f4f5f7;
      border: none !important; /* Light gray: NO outline */
      color: #000000;
    }

    .badge-dark {
      background-color: #333333;
      border: none !important; /* Dark gray: NO outline */
      color: #ffffff !important; /* Dark gray: WHITE text */
    }
    .badge-dark * {
      color: #ffffff !important;
    }

    .badge-black {
      background-color: #000000;
      border: none !important; /* Black: NO outline */
      color: #ffffff !important; /* Black: WHITE text */
    }
    .badge-black * {
      color: #ffffff !important;
    }

    /* Black box with white line (검은 박스 흰 라인) */
    .badge-black-line,
    .dark-box-white-line {
      background-color: #000000 !important;
      border: 1px solid #ffffff !important;
      color: #ffffff !important;
    }
    .badge-black-line *,
    .dark-box-white-line * {
      color: #ffffff !important;
    }

    /* Fallback protection: white badges/cards in dark containers become black box with white line */
    .dark-card .badge-white,
    .black-card .badge-white,
    .banner-dark .badge-white,
    .banner-black .badge-white,
    [style*="background-color: #000000"] .badge-white,
    [style*="background-color: #333333"] .badge-white,
    [style*="background-color:#000000"] .badge-white,
    [style*="background-color:#333333"] .badge-white,
    [style*="background: #000000"] .badge-white,
    [style*="background: #333333"] .badge-white {
      background-color: #000000 !important;
      border: 1px solid #ffffff !important;
      color: #ffffff !important;
    }

    .dark-card .white-card,
    .black-card .white-card,
    .banner-dark .white-card,
    .banner-black .white-card,
    [style*="background-color: #000000"] .white-card,
    [style*="background-color: #333333"] .white-card,
    [style*="background-color:#000000"] .white-card,
    [style*="background-color:#333333"] .white-card,
    [style*="background: #000000"] .white-card,
    [style*="background: #333333"] .white-card {
      background-color: #000000 !important;
      border: 1px solid #ffffff !important;
      color: #ffffff !important;
    }

    /* Automatic text color enforcement for inline dark gray & black backgrounds */
    [style*="background-color: #000000"],
    [style*="background-color: #333333"],
    [style*="background-color:#000000"],
    [style*="background-color:#333333"],
    [style*="background: #000000"],
    [style*="background: #333333"],
    [style*="background:#000000"],
    [style*="background:#333333"] {
      color: #ffffff !important;
    }

    [style*="background-color: #000000"] *,
    [style*="background-color: #333333"] *,
    [style*="background-color:#000000"] *,
    [style*="background-color:#333333"] *,
    [style*="background: #000000"] *,
    [style*="background: #333333"] *,
    [style*="background:#000000"] *,
    [style*="background:#333333"] * {
      color: #ffffff !important;
    }

    /* Grid Layouts */
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    /* Card Details */
    .card-title {
      font-size: 21px;
      font-weight: 900;
      line-height: 1.35;
      letter-spacing: -0.4px;
      margin-bottom: 12px;
    }

    .card-text {
      font-size: 16px;
      font-weight: 500;
      line-height: 1.65;
      letter-spacing: -0.3px;
    }

    .stat-number {
      font-size: 54px;
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -1.5px;
      margin: 10px 0;
    }

    .stat-label {
      font-size: 14.5px;
      font-weight: 500;
      line-height: 1.6;
      letter-spacing: -0.3px;
    }

    /* Left & Right Edge Navigation Hotspots */
    .nav-edge {
      position: fixed;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 99999;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.2s ease, opacity 0.2s ease;
      opacity: 0.15;
    }

    .nav-edge:hover {
      opacity: 1;
      background-color: rgba(0, 0, 0, 0.03);
    }

    .nav-edge.left {
      left: 0;
    }

    .nav-edge.right {
      right: 0;
    }

    .nav-btn {
      width: 54px;
      height: 54px;
      border-radius: 0;
      background-color: #ffffff;
      border: 1.5px solid #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
      transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .nav-edge:hover .nav-btn {
      transform: scale(1.08);
      background-color: #f4f5f7;
    }

    .nav-arrow {
      width: 14px;
      height: 14px;
      border-top: 2.5px solid #000000;
      border-right: 2.5px solid #000000;
      display: inline-block;
    }

    .nav-arrow.prev {
      transform: rotate(-135deg);
      margin-left: 4px;
    }

    .nav-arrow.next {
      transform: rotate(45deg);
      margin-right: 4px;
    }
  </style>
</head>
